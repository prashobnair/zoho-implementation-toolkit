{
  "$defs": {
    "Finding": {
      "description": "A single surfaced issue with source provenance.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "docs_url": {
          "default": "",
          "title": "Docs Url",
          "type": "string"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "remediation": {
          "default": "",
          "title": "Remediation",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "id",
        "module",
        "code",
        "severity",
        "entity",
        "entity_id",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ReportSource": {
      "description": "Where the audited data came from (STD \u00a73.5). Never raw org IDs.",
      "properties": {
        "dc": {
          "default": "in",
          "title": "Dc",
          "type": "string"
        },
        "kind": {
          "default": "fixture",
          "enum": [
            "fixture",
            "zoho"
          ],
          "title": "Kind",
          "type": "string"
        },
        "org_fingerprint": {
          "default": "",
          "title": "Org Fingerprint",
          "type": "string"
        }
      },
      "title": "ReportSource",
      "type": "object"
    },
    "ReportSummary": {
      "description": "Counts of findings by severity.",
      "properties": {
        "error": {
          "default": 0,
          "title": "Error",
          "type": "integer"
        },
        "info": {
          "default": 0,
          "title": "Info",
          "type": "integer"
        },
        "review": {
          "default": 0,
          "title": "Review",
          "type": "integer"
        },
        "warning": {
          "default": 0,
          "title": "Warning",
          "type": "integer"
        }
      },
      "title": "ReportSummary",
      "type": "object"
    },
    "Severity": {
      "description": "Finding severity, ordered most to least severe.",
      "enum": [
        "error",
        "review",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SideEffects": {
      "description": "Count of real-world side effects (always zero for audits).",
      "properties": {
        "external_writes": {
          "default": 0,
          "title": "External Writes",
          "type": "integer"
        },
        "messages_sent": {
          "default": 0,
          "title": "Messages Sent",
          "type": "integer"
        }
      },
      "title": "SideEffects",
      "type": "object"
    }
  },
  "description": "Versioned report envelope per STD \u00a73.5.",
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "inputs_sha256": {
      "default": "",
      "title": "Inputs Sha256",
      "type": "string"
    },
    "mode": {
      "default": "offline",
      "enum": [
        "offline",
        "live_read"
      ],
      "title": "Mode",
      "type": "string"
    },
    "module": {
      "title": "Module",
      "type": "string"
    },
    "ready": {
      "title": "Ready",
      "type": "boolean"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "side_effects": {
      "$ref": "#/$defs/SideEffects"
    },
    "source": {
      "$ref": "#/$defs/ReportSource"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/ReportSummary"
    },
    "tool": {
      "default": "zohokit",
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "default": "0.0.0",
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "module",
    "run_id",
    "started_at",
    "finished_at",
    "ready",
    "summary"
  ],
  "title": "Report",
  "type": "object"
}
