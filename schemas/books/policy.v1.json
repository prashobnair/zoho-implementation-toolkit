{
  "$defs": {
    "AllowMultiple": {
      "description": "When several invoices may sum to one deal net (UC-BK-2 staged billing).",
      "properties": {
        "billing_plan_field": {
          "default": "Billing_Plan",
          "title": "Billing Plan Field",
          "type": "string"
        }
      },
      "title": "AllowMultiple",
      "type": "object"
    },
    "CrmDealFields": {
      "description": "CRM field names mapped to offline deal attributes (live Deals read).\n\nThe live recon reads Deals through the GET-only CRM v8 reader with\nthese fields (plus ``id``) in the explicit ``fields=`` list the API\nrequires. ``entity`` names the CRM field holding the entity\ndiscriminator matched against each entity map entry's\n``crm_criteria`` (default ``Entity``, as in the Marigold fixture).",
      "properties": {
        "amount": {
          "default": "Amount",
          "title": "Amount",
          "type": "string"
        },
        "billing_plan": {
          "default": "Billing_Plan",
          "title": "Billing Plan",
          "type": "string"
        },
        "closing_date": {
          "default": "Closing_Date",
          "title": "Closing Date",
          "type": "string"
        },
        "currency": {
          "default": "Currency",
          "title": "Currency",
          "type": "string"
        },
        "customer": {
          "default": "Account_Name",
          "title": "Customer",
          "type": "string"
        },
        "entity": {
          "default": "Entity",
          "title": "Entity",
          "type": "string"
        }
      },
      "title": "CrmDealFields",
      "type": "object"
    },
    "PeriodWindow": {
      "description": "Month window; both bounds inclusive (see :mod:`period`).",
      "properties": {
        "by": {
          "default": "deal_closing_date",
          "enum": [
            "deal_closing_date",
            "invoice_date"
          ],
          "title": "By",
          "type": "string"
        },
        "end": {
          "default": "2026-09-30",
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "default": "2026-09-01",
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "title": "PeriodWindow",
      "type": "object"
    },
    "Tolerance": {
      "description": "Absolute + percentage tolerance bounds (only stated bounds apply).",
      "properties": {
        "abs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abs"
        },
        "pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pct"
        }
      },
      "title": "Tolerance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Validated Books reconciliation policy (TK-BK-F1).",
  "properties": {
    "allow_multiple_invoices_when": {
      "anyOf": [
        {
          "$ref": "#/$defs/AllowMultiple"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "credit_notes": {
      "const": "net_off",
      "default": "net_off",
      "title": "Credit Notes",
      "type": "string"
    },
    "crm_fields": {
      "$ref": "#/$defs/CrmDealFields"
    },
    "custom_field_label": {
      "default": "CRM Deal ID",
      "title": "Custom Field Label",
      "type": "string"
    },
    "include_draft": {
      "default": false,
      "title": "Include Draft",
      "type": "boolean"
    },
    "include_void": {
      "default": false,
      "title": "Include Void",
      "type": "boolean"
    },
    "key_strategy": {
      "default": "crm_deal_id_in_invoice_custom_field",
      "enum": [
        "crm_deal_id_in_invoice_custom_field",
        "reference_number",
        "sales_order_link"
      ],
      "title": "Key Strategy",
      "type": "string"
    },
    "period": {
      "anyOf": [
        {
          "$ref": "#/$defs/PeriodWindow"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tax": {
      "default": "compare_net_only",
      "enum": [
        "compare_net_only",
        "compare_gross_with_tax_table"
      ],
      "title": "Tax",
      "type": "string"
    },
    "tax_table": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "title": "Tax Table",
      "type": "object"
    },
    "tolerance": {
      "$ref": "#/$defs/Tolerance"
    }
  },
  "title": "MatchPolicy",
  "type": "object"
}
