{
  "$defs": {
    "AiUsage": {
      "description": "Token, cost and latency accounting for one AI call (STD-AI9).",
      "properties": {
        "estimated_cost_usd": {
          "default": 0.0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "prompt_hash": {
          "default": "",
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_version": {
          "default": "",
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "status": {
          "default": "disabled",
          "enum": [
            "disabled",
            "ok",
            "repaired",
            "fallback"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "AiUsage",
      "type": "object"
    },
    "ExplainSentence": {
      "description": "One narrative sentence restating report findings (TK-CORE-9).",
      "properties": {
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "quotes": {
          "items": {
            "type": "string"
          },
          "title": "Quotes",
          "type": "array"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "title": "ExplainSentence",
      "type": "object"
    }
  },
  "description": "One explain run: suggestion sentences plus traceability (STD-AI5/9).",
  "properties": {
    "ai_status": {
      "default": "template",
      "title": "Ai Status",
      "type": "string"
    },
    "audience": {
      "default": "internal",
      "title": "Audience",
      "type": "string"
    },
    "model": {
      "default": "",
      "title": "Model",
      "type": "string"
    },
    "prompt_hash": {
      "default": "",
      "title": "Prompt Hash",
      "type": "string"
    },
    "prompt_version": {
      "default": "template",
      "title": "Prompt Version",
      "type": "string"
    },
    "sentences": {
      "items": {
        "$ref": "#/$defs/ExplainSentence"
      },
      "title": "Sentences",
      "type": "array"
    },
    "source": {
      "default": "ai",
      "title": "Source",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/AiUsage"
    }
  },
  "title": "ExplainResult",
  "type": "object"
}
